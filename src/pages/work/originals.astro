---
import '../../styles/global.css';
import Header from '../../components/Header.astro';

const title = 'Originals — Lenzatic';
const description = 'Lenzatic Originals: awaiting its debut.';
---

<!doctype html>
<html lang="en" style="background:#000">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href="https://www.lenzatic.com/work/originals" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Salena.woff2" crossorigin />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>

  <body class="overflow-hidden font-display uppercase text-white" style="background:#000">
    <Header current="work" fixed />

    <main class="orig relative h-svh min-h-[520px] w-full overflow-hidden">
      <!-- Backdrop: the Originals still, deep in shadow, slowly breathing -->
      <div data-orig-bg class="orig-bg absolute inset-0" aria-hidden="true">
        <img src="/images/work/00-originals.jpg" srcset="/images/work/00-originals-1000.webp 1000w, /images/work/00-originals.webp 2000w" sizes="100vw" alt="" class="h-full w-full object-cover object-[50%_30%]" />
      </div>
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.35)_0%,rgba(0,0,0,0.85)_60%,#000_100%)]" aria-hidden="true"></div>
      <div class="orig-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div data-orig-scan class="orig-scan pointer-events-none absolute inset-x-0 top-0" aria-hidden="true"></div>

      <!-- Viewfinder corners + HUD readouts -->
      <div class="pointer-events-none absolute inset-x-6 bottom-6 top-24 sm:inset-x-12 sm:bottom-10 sm:top-32" aria-hidden="true">
        <span data-hud class="absolute left-0 top-0 h-6 w-6 border-l border-t border-white/50"></span>
        <span data-hud class="absolute right-0 top-0 h-6 w-6 border-r border-t border-white/50"></span>
        <span data-hud class="absolute bottom-0 left-0 h-6 w-6 border-b border-l border-white/50"></span>
        <span data-hud class="absolute bottom-0 right-0 h-6 w-6 border-b border-r border-white/50"></span>
        <p data-hud class="absolute left-4 top-4 text-[9px] tracking-[0.3em] text-white/50 sm:left-6 sm:top-5 sm:text-[10px]">Lenzatic / Originals</p>
        <p data-hud class="absolute right-4 top-4 flex items-center gap-2 text-[9px] tracking-[0.3em] text-white/50 sm:right-6 sm:top-5 sm:text-[10px]">
          <span class="orig-standby inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-gold)]"></span>
          <span data-status>Standby</span>
        </p>
        <div data-hud class="absolute bottom-4 left-4 right-4 flex items-center gap-3 sm:bottom-5 sm:left-6 sm:right-6">
          <span class="text-[9px] tracking-[0.3em] text-white/50 sm:text-[10px]">Signal</span>
          <span class="relative h-px flex-1 bg-white/15"><span data-signal class="absolute inset-y-0 left-0 w-0 bg-[var(--color-gold)]"></span></span>
          <span data-pct class="w-[4ch] text-right text-[9px] tracking-[0.2em] text-white/50 sm:text-[10px]">000</span>
        </div>
      </div>

      <!-- The message -->
      <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
        <p data-kicker class="mb-5 text-[10px] tracking-[0.5em] text-[var(--color-gold)] sm:mb-7 sm:text-[11px]">Originals</p>
        <h1 class="relative">
          <span class="sr-only">Originals: awaiting its debut. Coming soon.</span>
          <span data-line class="orig-line block text-[clamp(1.6rem,6.4vw,4.6rem)] leading-none tracking-[0.18em]" aria-hidden="true">Coming Soon</span>
        </h1>
        <span data-rule class="mt-6 block h-px w-[min(60vw,420px)] origin-center bg-white/40 sm:mt-8" aria-hidden="true"></span>
        <a href="/work" class="link-draw mt-8 text-[10px] tracking-[0.3em] text-white/70 sm:mt-10 sm:text-[11px]">&larr;&nbsp; All work</a>
      </div>
    </main>

    <div class="grain hidden [.js_&]:block" aria-hidden="true"></div>

    <script>
      import '../../scripts/originals.ts';
    </script>
  </body>
</html>
