---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { reel, manifestUrl, posterUrl, STREAM_BASE } from '../data/reel';

const title = 'Lenzatic by Roberto Lee Cortes';
const description = 'Lenzatic is the cinematography portfolio of Roberto Lee Cortes.';
const pad = (n: number) => String(n).padStart(2, '0');
// The looping dial needs at least 3 slots to wrap smoothly, so a 2-clip reel is shown twice.
const dialSlots = reel.length === 2 ? [...reel, ...reel] : reel;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href="https://www.lenzatic.com/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.lenzatic.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.lenzatic.com/images/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href={STREAM_BASE} crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={posterUrl(reel[0].id)} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Salena.woff2" crossorigin />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>

  <body class="overflow-hidden bg-black font-display uppercase">
    <!-- Preloader: two shutters that part like a letterbox opening -->
    <div id="preloader" class="pointer-events-none fixed inset-0 z-[5000] hidden [.js_&]:block" aria-hidden="true">
      <div data-shutter="top" class="absolute inset-x-0 top-0 h-1/2 bg-ink"></div>
      <div data-shutter="bottom" class="absolute inset-x-0 bottom-0 h-1/2 bg-ink"></div>
      <div data-loader-content class="absolute inset-0 flex flex-col items-center justify-center gap-6">
        <div class="relative w-[min(64vw,420px)] overflow-hidden">
          <div data-loader-logo class="logo-mask w-full bg-mist"></div>
          <div data-loader-sheen class="logo-mask absolute inset-0 w-full bg-gradient-to-r from-transparent via-ochre to-transparent bg-[length:40%_100%] bg-no-repeat opacity-80"></div>
        </div>
        <div class="h-px w-[min(64vw,420px)] bg-mist/15">
          <div data-loader-bar class="h-px w-full origin-left scale-x-0 bg-ochre"></div>
        </div>
        <p data-loader-tc class="text-[11px] tracking-[0.3em] text-haze">00:00:00:00</p>
      </div>
    </div>

    <main id="home" class="relative h-svh min-h-[520px] w-full touch-none overflow-hidden">
      <h1 class="sr-only">Lenzatic — Roberto Lee Cortes, Cinematographer</h1>

      <!-- Reel: one full-screen layer per clip, revealed with a vertical wipe -->
      <div data-clips class="absolute inset-0">
        {reel.map((clip, i) => (
          <div
            data-clip={i}
            class="absolute inset-0 overflow-hidden bg-black"
            style={`clip-path: ${i === 0 ? 'inset(0% 0% 0% 0%)' : 'inset(100% 0% 0% 0%)'}; z-index: ${i === 0 ? 1 : 0}`}
          >
            <img
              data-poster
              src={posterUrl(clip.id)}
              alt=""
              class="absolute inset-0 h-full w-full object-cover transition-opacity duration-700"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <video
              data-src={manifestUrl(clip.id)}
              data-start={clip.start}
              data-length={clip.length}
              class="absolute inset-0 h-full w-full object-cover"
              muted
              loop
              playsinline
              preload="none"
              aria-label={`${clip.title} reel`}
            ></video>
          </div>
        ))}
        <div class="pointer-events-none absolute inset-0 z-[4000] bg-gradient-to-b from-black/40 via-transparent to-black/85"></div>
      </div>

      <!-- Brand mark, centered over the reel -->
      <img
        data-mark
        src="/images/lenzatic-mark.svg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-1/2 z-[4400] w-6 -translate-x-1/2 -translate-y-1/2 drop-shadow-[0_2px_14px_rgba(0,0,0,0.35)] sm:w-8"
      />

      <Header current="home" />

      <!-- Bottom: counter + title, dial, prev/next -->
      <div class="reel-bar absolute inset-x-0 bottom-0 z-[4500] grid grid-cols-[1fr_auto] items-end gap-x-3 gap-y-5 md:grid-cols-[1fr_auto_1fr] px-6 pb-5 text-white mix-blend-difference sm:px-12 sm:pb-8">
        <div class="col-span-2 flex flex-col gap-1.5 md:col-span-1">
          <div class="overflow-hidden">
            <div data-intro-up class="flex gap-1 text-[11px] tracking-[0.2em]">
              <span data-counter class="inline-flex">{[..."01"].map((d) => <span data-digit class="digit relative overflow-hidden"><span class="block">{d}</span></span>)}</span>
              <span class="opacity-60">/</span>
              <span class="opacity-60">{[...pad(reel.length)].map((d) => <span class="digit">{d}</span>)}</span>
            </div>
          </div>
          <h2 class="overflow-hidden">
            <span data-intro-up class="block">
              <span data-roll="title" class="relative block h-[1.2em] overflow-hidden text-sm leading-[1.2] tracking-[0.22em] sm:text-base"><span class="block">{reel[0].title}</span></span>
            </span>
          </h2>
        </div>

        <div class="overflow-hidden pt-2">
          <nav data-intro-up aria-label="Reel" class="pointer-events-auto mx-auto w-36 md:w-64">
            <div data-dial class="dial-mask flex w-full cursor-grab select-none flex-row items-end overflow-hidden active:cursor-grabbing">
              {dialSlots.map((clip, n) => {
                const i = n % reel.length;
                return (
                  <div
                    role="button"
                    tabindex="0"
                    data-dial-item={i}
                    aria-label={`Show ${clip.title}`}
                    class="relative flex h-10 w-[4.5rem] shrink-0 flex-col items-center justify-center pt-4 md:w-28"
                  >
                    <span data-num class="absolute left-1/2 top-0 -translate-x-1/2 text-[9px] tracking-[0.15em]" style={`opacity: ${i === 0 ? 1 : 0.4}`}>{pad(i + 1)}</span>
                    <span class="flex h-5 w-full flex-row justify-between" aria-hidden="true">
                      <span class="my-auto h-1.5 w-px bg-current"></span>
                      <span class="my-auto h-1.5 w-px bg-current"></span>
                      <span class="my-auto h-1.5 w-px bg-current"></span>
                      <span data-tick class="h-full w-px origin-center bg-current" style={`transform: scaleY(${i === 0 ? 1 : 0.3})`}></span>
                      <span class="my-auto h-1.5 w-px bg-current"></span>
                      <span class="my-auto h-1.5 w-px bg-current"></span>
                      <span class="my-auto h-1.5 w-0"></span>
                    </span>
                  </div>
                );
              })}
            </div>
          </nav>
        </div>

        <div class="justify-self-end">
          <div class="overflow-hidden">
            <div data-intro-up class="pointer-events-auto flex gap-2">
              <button type="button" data-step="prev" class="arrow-btn">
                <svg viewBox="0 0 44 36" aria-hidden="true">
                  <path class="frame" d="M1.5 1.5V34.5L42.5 18Z" />
                  <path class="arrow" d="M8 11V25L26 18Z" />
                </svg>
                <span class="sr-only">Previous clip</span>
              </button>
              <button type="button" data-step="next" class="arrow-btn">
                <svg viewBox="0 0 44 36" aria-hidden="true">
                  <path class="frame" d="M1.5 1.5V34.5L42.5 18Z" />
                  <path class="arrow" d="M8 11V25L26 18Z" />
                </svg>
                <span class="sr-only">Next clip</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div class="grain hidden [.js_&]:block" aria-hidden="true"></div>

    <script>
      import '../scripts/home.ts';
    </script>
  </body>
</html>
